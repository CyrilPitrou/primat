# Include C source and header files needed to compile the _primat_c extension
recursive-include primat-c/src *.c
recursive-include primat-c/include *.h
include primat/_primat_c_src/_wrapper.c

# Include the standalone primat-c build/usage material -- useful to sdist
# consumers (e.g. debian/conda packagers) who want to build primat-c
# independently of the Python extension (see primat-c/README.md).
include primat-c/Makefile
recursive-include primat-c/examples *.ini
