CLAUDE.md
AGENTS.md

# Local Claude Code tooling settings
.claude/

# Local Codex CLI tooling settings (machine-specific paths, e.g. hooks.json)
.codex/

# Runtime-generated n<->p weak-rate cache files (fingerprinted, one per
# background config). The shipped set under primat/data/cache_plasma_weak/weak/
# stays tracked (already committed); this only ignores new files a local run
# regenerates.
primat/data/cache_plasma_weak/weak/nTOp_*.txt

# Same, for the e+- thermodynamic tables. These became hash-named (one file per
# configuration, like the weak tables above) so that configurations stop
# evicting one another -- which is what stopped a full test-suite run leaving
# the shipped, git-tracked copy modified. The flip side is that a run with a
# non-default n_electron_table/T_start_cosmo_MeV (e.g. the high-precision
# reference fixture in tests/test_regression.py) now drops its *own* file here,
# which is correct but is a local artifact, not something to commit. The
# shipped file stays tracked exactly as the weak ones do.
primat/data/cache_plasma_weak/plasma/electron_thermo_*.txt

# Rate tables generated by generate_rates/thermal_average.ipynb
generate_rates/rate_tables_out/

# Fuzzing (primat-c/tests/fuzz): the corpora and the minimised reproducers are
# tracked, the crash artifacts of a local campaign are not.
primat-c/tests/fuzz/artifacts/
